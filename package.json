{
  "name": "nextchina-org",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack --hostname 127.0.0.1",
    "build": "next build --webpack",
    "typecheck": "tsc --noEmit",
    "test": "npm run media:check && node --test tests/*.test.mjs",
    "test:browser": "playwright test",
    "emails:build": "node scripts/build-auth-emails.mjs",
    "media:check": "wrangler types workers/media/worker-configuration.d.ts --config workers/media/wrangler.jsonc --include-runtime=false && tsc -p workers/media/tsconfig.json && wrangler deploy --dry-run --outdir ../../media-dist --config workers/media/wrangler.jsonc"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.117.3",
    "@tailwindcss/postcss": "^4.1.0",
    "@tiptap/extension-image": "3.31.4",
    "@tiptap/extension-placeholder": "3.31.4",
    "@tiptap/pm": "3.31.4",
    "@tiptap/react": "3.31.4",
    "@tiptap/starter-kit": "3.31.4",
    "next": "16.4.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-easy-crop": "6.2.4",
    "react-icons": "^5.5.0",
    "tailwindcss": "^4.1.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261013.1",
    "@electric-sql/pglite": "^0.3.0",
    "@playwright/test": "^1.58.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "typescript": "^5.9.0",
    "wrangler": "4.149.0"
  }
}
