{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "chinateam-wallet",
  "account_id": "4c7d8ee3a4d2568ad8e306be077f11a1",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-15",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": true,
  "services": [
    {
      "binding": "PRICE_SOURCE",
      "service": "teamcn-prices"
    }
  ],
  "routes": [],
  "triggers": {
    "crons": [
      "* * * * *"
    ]
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.1
  },
  "ratelimits": [
    {
      "name": "PRICE_LIMITER",
      "namespace_id": "1005",
      "simple": {
        "limit": 120,
        "period": 60
      }
    },
    {
      "name": "PAYOUT_LIMITER",
      "namespace_id": "1004",
      "simple": {
        "limit": 12,
        "period": 60
      }
    }
  ],
  "vars": {
    "SUPABASE_URL": "https://cznhnupwojmydttdattb.supabase.co",
    "SUPABASE_PUBLISHABLE_KEY": "sb_publishable_S64GsjK-R_CGycTdquKVxw_17Y13ZlL",
    "ALLOWED_ORIGINS": "https://omniremix.pages.dev,https://teamcn-admin.pages.dev,https://omniremix.chentieshu520.chatgpt.site"
  },
  "secrets": {
    "required": [
      "WALLET_GATEWAY_KEY",
      "TRONGRID_API_KEY"
    ]
  },
  "preview_urls": false
